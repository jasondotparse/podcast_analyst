// LadybugDB schema from docs/database_design.md. Node IDs are Postgres UUIDs.
// Applied at every startup; the graph can be rebuilt from Postgres.
CREATE NODE TABLE IF NOT EXISTS Episode(id STRING PRIMARY KEY);
CREATE NODE TABLE IF NOT EXISTS Passage(id STRING PRIMARY KEY);
CREATE NODE TABLE IF NOT EXISTS Claim(id STRING PRIMARY KEY);
CREATE NODE TABLE IF NOT EXISTS Thesis(id STRING PRIMARY KEY);
CREATE NODE TABLE IF NOT EXISTS Entity(id STRING PRIMARY KEY, name STRING, kind STRING);

CREATE REL TABLE IF NOT EXISTS CONTAINS(FROM Episode TO Passage);
CREATE REL TABLE IF NOT EXISTS EVIDENCED_BY(FROM Claim TO Passage);
CREATE REL TABLE IF NOT EXISTS ABOUT(FROM Claim TO Entity, FROM Thesis TO Entity);
CREATE REL TABLE IF NOT EXISTS SUPPORTS(FROM Claim TO Thesis);
CREATE REL TABLE IF NOT EXISTS CHALLENGES(FROM Claim TO Thesis);
CREATE REL TABLE IF NOT EXISTS MENTIONS(FROM Passage TO Entity);

// Claim.signal (0-100, from Postgres claims.signal) lets traversals rank claims without a
// SQL round trip. ALTER rather than a column in CREATE so existing graphs gain it too.
ALTER TABLE Claim ADD IF NOT EXISTS signal INT64;
ALTER TABLE SUPPORTS ADD IF NOT EXISTS strength INT64;
ALTER TABLE CHALLENGES ADD IF NOT EXISTS strength INT64;
